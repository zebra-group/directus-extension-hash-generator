{
	"name": "directus-extension-hash-generator",
	"description": "A Directus extension for generating hashes",
	"author": {
		"name": "Otto Apel",
		"email": "otto.apel@gmail.com"
	},
	"icon": "extension",
	"version": "1.0.1",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/mindbox/directus-extension-hash-generator"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"build:extension": "run-p type-check \"build {@}\" --",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"test:unit": "vitest",
		"type-check": "vue-tsc --noEmit"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "16.0.0",
		"@vue/test-utils": "^2.4.6",
		"jsdom": "^26.1.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4",
		"vue": "^3.5.20",
		"vue-tsc": "^3.0.6"
	}
}
